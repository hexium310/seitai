{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>hexium310/renovate-config",
    "github>hexium310/renovate-config:labels"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 3"]
  },
  "packageRules": [
    {
      "groupName": "kubernetes",
      "matchManagers": "cargo",
      "matchPackageNames": [
        "kube",
        "k8s-openapi"
      ],
      "minimumGroupSize": 2,
      "separateMajorMinor": false
    },
    {
      "groupName": "sqlx",
      "matchManagers": "cargo",
      "matchPackageNames": [
        "sea-query*",
        "sqlx*"
      ],
      "separateMajorMinor": false
    }
  ]
}
